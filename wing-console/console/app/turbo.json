{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["^compile"]
    },
    "compile": {
      "outputs": ["dist/**"],
      "env": ["SEGMENT_WRITE_KEY"]
    },
    "package": {
      "outputs": ["../../../dist/wingconsole-app-*.tgz"]
    }
  }
}
